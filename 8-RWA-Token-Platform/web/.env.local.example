# RPC del nodo local (anvil) / local node RPC
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337

# Capa off-chain (MongoDB). Opcional: si no está disponible, la web degrada con gracia
# (los datos off-chain quedan vacíos y el dApp on-chain sigue funcionando).
# Off-chain layer (MongoDB). Optional: if unavailable the app degrades gracefully.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rwa
